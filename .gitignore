.vagrant/

# Editor/OS transient files
.DS_Store
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
*.orig
*.rej

# Session-specific agent output artifacts
# (generated by AI agent workflows; not committed)
.agents/results/*.json

# Transient session/audit notes — committed copies are removed; prevent recurrence
NEXT_SESSION.md
AUDIT-REPORT.md
*_PRD.md

# Generated/CI artifacts that must not be committed
docs/variables.generated.md
benchmark-results/
